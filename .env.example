# Shared Supabase Postgres connection string (Transaction pooler port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase project URL & service/secret key for private Storage buckets
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SECRET_KEY="[YOUR-SUPABASE-SECRET-KEY]"

# HMAC session signing secret (required in production, minimum 32 characters)
PORTAL_SESSION_SECRET="[GENERATE-A-RANDOM-32-PLUS-CHAR-SECRET]"

# Public origin URL of the portal for CSRF origin verification in production
PORTAL_PUBLIC_URL="https://portal.example.com"

# Bearer token used by Vercel Cron to authorize /api/cron/deadline-reminders
CRON_SECRET="[GENERATE-A-RANDOM-CRON-SECRET]"

# Optional SMTP settings for transactional emails (self-registration requires email enabled)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="info@example.com"
SMTP_PASS="[YOUR-SMTP-PASSWORD]"
SMTP_FROM='"Logix Internship Portal" <info@logixofficial.site>'
